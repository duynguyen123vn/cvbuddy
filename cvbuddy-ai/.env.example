# =============================================================================
# CVBuddy AI — copy this file to .env and fill in values
# =============================================================================

# --- LLM provider selection ---
# groq | mock
LLM_PROVIDER=groq

# --- Groq (OpenAI-compatible) ---
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
# Model ids change; list current ids via:
#   .venv\Scripts\python.exe scripts\list_groq_models.py
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_EXTRACT_MODEL=qwen/qwen3.8-27b
GROQ_ANALYZE_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# true = deterministic mock responses; false = configured provider
MOCK_LLM=false

# --- Service ---
APP_ENV=development
APP_VERSION=0.1.0
# Use the exact deployed Git commit SHA in production. This is public metadata, not a secret.
APP_COMMIT=local
LOG_LEVEL=INFO
API_PREFIX=/v1
AI_RATE_LIMIT_PER_MINUTE=60
AI_INTERNAL_API_KEY=
AI_SCHEMA_VERSION=ai-response-v1
AI_PROMPT_VERSION=cv-prompts-v1

# Comma-separated origins for React/Vite dev server
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
