# =============================================================================
# CVBuddy AI — copy this file to .env and fill in values
# =============================================================================

# --- LLM provider selection ---
# ollama | groq | mock
LLM_PROVIDER=groq

# --- Groq (OpenAI-compatible) ---
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
# Model ids change; list current ids via:
#   .venv\Scripts\python.exe scripts\list_groq_models.py
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_EXTRACT_MODEL=qwen/qwen3-32b
GROQ_ANALYZE_MODEL=qwen/qwen3.6-27b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# --- Ollama (fully local, no API key) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EXTRACT_MODEL=qwen3.5:4b
OLLAMA_ANALYZE_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120

# true = deterministic mock responses; false = configured provider
MOCK_LLM=false

# --- Service ---
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/v1

# Comma-separated origins for React/Vite dev server
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
